db.shops.aggregate([
    {
        $geoNear: {
            near: {
                type: 'Point',
                coordinates: [
                    12.97,
                    77.6
                ]
            },
            distanceField: 'distance',
            maxDistance: 500000,
            spherical: true
        }
    },
    {
        $lookup: {
            from: 'products',
            localField: '_id',
            foreignField: 'shopId',
            as: 'products'
        }
    },
    {
        password: 0
    }
])
