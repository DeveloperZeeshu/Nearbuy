db.shops.aggregate([
    {
        $geoNear: {
            near: {
                type: 'Point',
                coordinates: [
                    26.97,
                    77.6
                ]
            },
            distanceField: 'distance',
            maxDistance: 500000,
            spherical: true,
        }
    },
    {
        $lookup: {
            from: 'products',
            let: {shopId: '$_id'
            },
            pipeline: [
                {
                $match: {
                    $expr: {$eq: ['$shopId','$$shopId'
                            ]
                        },
                    name: {
                        $regex: 'dab',
                        $options: 'i'
                        },
                    category: 'Groceries'
                    }
                },
                {
                    $project: {
                        shopId: 0,
                        createdAt: 0,
                        updatedAt: 0,
                        __v: 0
                    }
                }
            ],
            as: 'product'
        }
    },
    {
        $unwind: '$product'
    },
    {
        $addFields: {
            distanceKm: {$round: [
                    {$divide: ['$distance',
                            1000
                        ]
                    },
                    2
                ]
            }
        }
    },
    {
        $project: {
            password: 0,
            createdAt: 0,
            distance: 0,
            updatedAt: 0,
            __v: 0
        }
    },
    {$sort: {distanceKm: 1, 'product.price': 1
        }
    },
    {$limit: 20
    }
])
